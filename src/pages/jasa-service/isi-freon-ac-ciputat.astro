    const base = (l) => l.split('?')[0];
    const msg = encodeURIComponent('Halo 23 Electronic, saya mau tanya pengecekan/isi freon AC di area [lokasi]. Merek/tipe AC: [..]. Keluhan: [tidak dingin/baru bongkar pasang/lainnya].');
    document.getElementById('bookWa').href = `${base(window.__waLink)}?text=${msg}`;
    document.getElementById('bookWa').target = '_blank';
  </script>
