  <script is:inline>window.__page = { active: 'produk', basePath: '../' };</script>
  <script is:inline src="../assets/partials.js"></script>
  <script is:inline>
    // Wire per-button WA messages
    document.querySelectorAll('.wa-link').forEach(a => {
      const msg = encodeURIComponent(a.dataset.msg || 'Halo 23 Electronic');
      const base = window.__waLink.split('?')[0];
      a.href = `${base}?text=${msg}`;
      a.target = '_blank';
      a.rel = 'noopener';
    });
    document.getElementById('asideWa').href = window.__waLink;
    document.getElementById('asideWa').target = '_blank';

    // AC capacity calculator
    (function () {
      const $ = id => document.getElementById(id);
      const sizes = [
        [5500, '1/2 PK'], [7500, '3/4 PK'], [10000, '1 PK'],
        [14000, '1,5 PK'], [19000, '2 PK'], [24000, '2,5 PK']
      ];
      $('pkGo').addEventListener('click', () => {
        const p = parseFloat($('pkP').value), l = parseFloat($('pkL').value);
        const o = Math.max(1, parseInt($('pkO').value, 10) || 1);
        if (!(p > 0) || !(l > 0)) { $('pkP').focus(); return; }
        const sun = parseFloat($('pkS').value), el = parseInt($('pkE').value, 10);
        const btu = Math.round(((p * l * 550) * sun + (o - 1) * 600 + el * 600) / 100) * 100;
        const hit = sizes.find(s => btu <= s[0]);
        const label = hit ? hit[1] : '3 PK atau lebih';
        $('pkPk').textContent = label;
        $('pkBtu').textContent = `≈ ${btu.toLocaleString('id-ID')} BTU/jam · ${(p * l).toFixed(1).replace('.', ',')} m²`;
        const msg = `Halo 23 Electronic, ruangan saya ${p}x${l} m (${o} orang). Hasil hitung kapasitas AC: ${label}. Ada stok AC ${label}? Berapa harganya?`;
        const a = $('pkWa');
        a.href = `${window.__waLink.split('?')[0]}?text=${encodeURIComponent(msg)}`;
        a.target = '_blank'; a.rel = 'noopener';
        $('pkResult').classList.add('show');
      });
    })();
  </script>
</body>
</html>
