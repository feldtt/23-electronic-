<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Jual AC di Ciputat — 23 Electronic</title>
  <meta name="description" content="Jual AC 1/2 PK, 3/4 PK, 1 PK, dan inverter di Ciputat. Tersedia paket pasang. Tanya stok dan harga hari ini via WhatsApp.">
  <link rel="stylesheet" href="../assets/styles.css">
</head>
<body>
  <div id="topbar"></div>
  <div id="header"></div>
  <div id="subnav"></div>

  <div class="crumbs">
    <div class="container">
      <a href="../index.html">Beranda</a><span class="sep">›</span>
      <a href="index.html">Produk</a><span class="sep">›</span>
      <strong>AC</strong>
    </div>
  </div>

  <section class="page-header">
    <div class="container">
      <h1>Jual AC di Ciputat dan Sekitarnya</h1>
      <p>AC split standard, low watt, dan inverter. Bisa beli unit saja atau bundel dengan paket pemasangan. Untuk stok hari ini dan harga final, hubungi admin via WhatsApp.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="two-col">
        <div>
          <h2 style="margin-bottom:16px;">Unit AC yang Tersedia</h2>
          <div class="grid-3">
            <div class="card">
              <div class="card-img has-photo"><img src="/assets/uploads/ac-lg-r32.jpeg" alt="LG Dual Cool R32" loading="lazy"></div>
              <div class="card-body">
                <h3>LG Dual Cool T05NSA</h3>
                <div class="card-meta">½ PK · 350 W · R32 · Turbo Cooling · Gold Fin · garansi kompresor 3 tahun</div>
                <div class="price">Cek harga via WA</div>
                <a href="#" class="btn btn-wa wa-link" data-msg="Halo 23 Electronic, mau tanya stok &amp; harga AC LG Dual Cool R32.">Tanya stok</a>
              </div>
            </div>
          </div>
          

          <h2 style="margin-top:48px;margin-bottom:16px;">Bundel Beli AC + Pasang</h2>
          <p style="color:var(--muted);margin-bottom:16px;">Paket pasang standar dijelaskan di awal. Biaya tambahan seperti pipa panjang, kabel, bracket, atau bobok dinding ditagih terpisah setelah survey.</p>
          <table class="price-table">
            <thead>
              <tr><th>Komponen</th><th>Keterangan</th></tr>
            </thead>
            <tbody>
              <tr><td>Pasang standar 1/2 PK – 1 PK</td><td>Pipa standar 3–4 meter, bracket, dudukan outdoor sederhana</td></tr>
              <tr><td>Tambahan pipa per meter</td><td>Bila lokasi outdoor jauh dari indoor</td></tr>
              <tr><td>Kabel power tambahan</td><td>Bila jalur stop kontak terlalu jauh</td></tr>
              <tr><td>Bobok dinding</td><td>Bila pipa harus menembus dinding</td></tr>
              <tr><td>Bracket outdoor</td><td>Untuk pemasangan di tembok luar</td></tr>
            </tbody>
          </table>
          <div class="notice">
            <strong>Harga tergantung kondisi lapangan.</strong>
            Untuk lokasi rumit (lantai 2, balkon sempit, atau perlu relokasi), kami sarankan survey terlebih dahulu sebelum pekerjaan dimulai.
          </div>

          <h2 style="margin-top:48px;margin-bottom:12px;">Merek yang Biasa Tersedia</h2>
          <p style="color:var(--muted);margin-bottom:16px;">Daftar merek bervariasi sesuai stok. Tanyakan merek yang Anda inginkan ke admin.</p>
          <div class="brand-strip">
            <div class="brand-chip">Daikin</div>
            <div class="brand-chip">Panasonic</div>
            <div class="brand-chip">LG</div>
            <div class="brand-chip">Sharp</div>
            <div class="brand-chip">Samsung</div>
            <div class="brand-chip">Toshiba</div>
          </div>
        </div>

        <aside>
          <div class="aside-card pk-calc">
            <h4>Hitung PK AC yang Cocok</h4>
            <p>Isi ukuran ruangan, kami hitung perkiraan kapasitas AC-nya.</p>
            <div class="row2">
              <div><label for="pkP">Panjang (m)</label><input id="pkP" type="number" min="1" max="30" step="0.1" value="4" inputmode="decimal"></div>
              <div><label for="pkL">Lebar (m)</label><input id="pkL" type="number" min="1" max="30" step="0.1" value="3" inputmode="decimal"></div>
            </div>
            <label for="pkO">Jumlah penghuni</label>
            <input id="pkO" type="number" min="1" max="30" step="1" value="2" inputmode="numeric">
            <label for="pkS">Kondisi ruangan</label>
            <select id="pkS">
              <option value="1">Lantai bawah / teduh</option>
              <option value="1.1" selected>Terkena sinar matahari sebagian</option>
              <option value="1.2">Lantai atas / bawah atap / jendela besar</option>
            </select>
            <label for="pkE">Peralatan elektronik (TV, PC, dll)</label>
            <select id="pkE">
              <option value="0">Sedikit</option>
              <option value="1" selected>Beberapa (TV / laptop)</option>
              <option value="2">Banyak (PC, kulkas, dapur)</option>
            </select>
            <button type="button" id="pkGo" class="btn btn-primary">Hitung Kapasitas</button>
            <div id="pkResult" class="pk-result" aria-live="polite">
              <p class="pk-small">Kapasitas yang disarankan</p>
              <p class="pk-big" id="pkPk"></p>
              <p class="pk-btu" id="pkBtu"></p>
              <a href="#" id="pkWa" class="btn btn-wa">Tanya Stok AC Ini</a>
            </div>
            <p class="pk-note">Perkiraan untuk plafon standar ±2,5–3 m. Untuk kepastian, chat admin.</p>
            <hr>
            <a href="#" id="asideWa" class="btn btn-secondary">Chat Admin Sekarang</a>
            <a href="../jasa-service/pasang-ac-ciputat.html" class="btn btn-secondary">Detail Paket Pasang AC</a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <div id="cta"></div>
  <div id="footer"></div>

  <script is:inline>window.__page = { active: 'produk', basePath: '../' };</script>
  <script is:inline src="../assets/partials.js"></script>
  <script is:inline>
    // Wire per-button WA messages
    document.querySelectorAll('.wa-link').forEach(a => {
      const msg = encodeURIComponent(a.dataset.msg || 'Halo 23 Electronic');
      const base = window.__waLink.split('?')[0];
      a.href = `${base}?text=${msg}`;
      a.target = '_blank';
      a.rel = 'noopener';
    });
    document.getElementById('asideWa').href = window.__waLink;
    document.getElementById('asideWa').target = '_blank';

    // AC capacity calculator
    (function () {
      const $ = id => document.getElementById(id);
      const sizes = [
        [5500, '1/2 PK'], [7500, '3/4 PK'], [10000, '1 PK'],
        [14000, '1,5 PK'], [19000, '2 PK'], [24000, '2,5 PK']
      ];
      $('pkGo').addEventListener('click', () => {
        const p = parseFloat($('pkP').value), l = parseFloat($('pkL').value);
        const o = Math.max(1, parseInt($('pkO').value, 10) || 1);
        if (!(p > 0) || !(l > 0)) { $('pkP').focus(); return; }
        const sun = parseFloat($('pkS').value), el = parseInt($('pkE').value, 10);
        const btu = Math.round(((p * l * 550) * sun + (o - 1) * 600 + el * 600) / 100) * 100;
        const hit = sizes.find(s => btu <= s[0]);
        const label = hit ? hit[1] : '3 PK atau lebih';
        $('pkPk').textContent = label;
        $('pkBtu').textContent = `≈ ${btu.toLocaleString('id-ID')} BTU/jam · ${(p * l).toFixed(1).replace('.', ',')} m²`;
        const msg = `Halo 23 Electronic, ruangan saya ${p}x${l} m (${o} orang). Hasil hitung kapasitas AC: ${label}. Ada stok AC ${label}? Berapa harganya?`;
        const a = $('pkWa');
        a.href = `${window.__waLink.split('?')[0]}?text=${encodeURIComponent(msg)}`;
        a.target = '_blank'; a.rel = 'noopener';
        $('pkResult').classList.add('show');
      });
    })();
  </script>
</body>
</html>
