        <script is:inline>
        (function () {
          var root = document.getElementById('flt'); if (!root) return;
          var cards = [].slice.call(document.querySelectorAll('.flt-main .card'));
          var boxes = [].slice.call(root.querySelectorAll('input'));
          function apply() {
            var sel = {};
            boxes.forEach(function (b) { sel[b.dataset.k] = sel[b.dataset.k] || []; if (b.checked) sel[b.dataset.k].push(b.value); });
            var shown = 0, seen = {};
            cards.forEach(function (c) {
              var ok = Object.keys(sel).every(function (k) {
                if (!sel[k].length) return true;
                var have = (c.dataset[k] || '').split('|');
                return sel[k].some(function (v) { return have.indexOf(v) > -1; });
              });
              c.style.display = ok ? '' : 'none';
              if (ok && !seen[c.dataset.id]) { seen[c.dataset.id] = 1; shown++; }
            });
            document.querySelectorAll('.flt-main .grid-3').forEach(function (g) {
              var any = [].some.call(g.children, function (c) { return c.style.display !== 'none'; });
              g.style.display = any ? '' : 'none';
              if (g.previousElementSibling) g.previousElementSibling.style.display = any ? '' : 'none';
            });
            document.getElementById('fltEmpty').hidden = shown > 0;
            var active = boxes.some(function (b) { return b.checked; });
            document.getElementById('fltCount').textContent = active ? shown + ' produk ditemukan' : '';
          }
          // The result list gets shorter than the page was, so the browser would clamp the scroll and the
          // sticky filter panel would jump. Keep the panel where it is: bring the top of the layout to the
          // sticky offset, so the results start next to the panel.
          var layout = root.closest('.flt-layout');
          function update() {
            apply();
            var top = layout.getBoundingClientRect().top;
            if (top < 90) window.scrollTo(0, window.scrollY + top - 90);
          }
          boxes.forEach(function (b) { b.addEventListener('change', update); });
          document.getElementById('fltReset').addEventListener('click', function () { boxes.forEach(function (b) { b.checked = false; }); update(); });
          document.getElementById('fltToggle').addEventListener('click', function () { root.classList.toggle('open'); });
        })();
        </script>

      <div class="notice notice-info" style="margin-top:32px;">
        <strong>Stok kategori ini bersifat tambahan.</strong>
        Fokus utama toko adalah AC, kulkas, mesin cuci, dan layanan service AC. Untuk barang kategori lain, konfirmasi ketersediaan dulu sebelum datang.
      </div>
    </div>
